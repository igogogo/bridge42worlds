@echo off
REM Уход за архивом после пополнения: разметка вектором + починка связей графа.
REM Ставится в планировщик задачей b42_upkeep, раз в сутки, ПОСЛЕ окна генерации.
REM
REM Почему две работы одной задачей, а не двумя. Обе нужны ровно после того, как архив
REM пополнился, и обе бесполезны, если он не пополнялся. Разнесённые по разным расписаниям,
REM они однажды разъедутся во времени — и починка графа отработает до разметки, то есть
REM по вчерашним связям. Порядок здесь важнее экономии одной строки в планировщике.
REM
REM Модель не зовётся ни там, ни там: разметка идёт по уже посчитанным векторам, починка —
REM по существующим связям. Значит задача бесплатная и её не надо согласовывать с бюджетом.

setlocal
set "REPO=C:\Users\nadez\PycharmProjects\bridge42worlds"
set "LOGDIR=%REPO%\logs"
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

for /f %%I in ('powershell -NoProfile -Command Get-Date -Format yyyyMMdd_HHmm') do set "STAMP=%%I"

cd /d "%REPO%"
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1

REM --apply обязателен: без него разметка считается и выбрасывается. Первая версия этой
REM обёртки его не ставила — задача честно отрабатывала каждую ночь и не записывала ничего.
python "%REPO%\tools\tag_by_vector.py" --apply >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
set RC=%ERRORLEVEL%

REM Починку графа запускаем ДАЖЕ если разметка споткнулась: она чинит то, что уже есть,
REM и от неудачи предыдущего шага хуже не станет. А вот код неудачи запоминаем — иначе
REM «упало первое, отработало второе» отчитается как успех.
python "%REPO%\tools\graph_repair.py" >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

REM Смысловой индекс — ПЕРЕД рекомендациями, и это порядок по существу. Рекомендации ищут
REM соседей в Vectorize; чего в индексе нет, того для них не существует. 11 августа замер
REM показал 2072 записи против 3657 статей архива: вектор гоняли руками, и хуже всего было
REM покрыто как раз то, что производится каждый день. Дельта по md5 — если ничего не
REM менялось, шаг отрабатывает за секунды. Ёмкость: 3657 × 1024 = 3.7 млн из 5 млн
REM бесплатных измерений, запас примерно на тысячу статей — дальше платный тариф.
REM Два шага, а не один: vector_build читает НЕ архив, а выгрузку embeddings_export.py
REM (английский текст статьи). Выгрузка тоже гонялась руками и устарела на 30 июля —
REM отсюда и взялись 2072 записи при 3657 статьях. Пропустишь первый шаг — второй честно
REM отчитается «индекс уже актуален» по вчерашнему списку.
python "%REPO%\embeddings_export.py" >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%
python "%REPO%\cloudflare\vector_build.py" >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

REM Оригинальные аннотации arXiv — из локального дампа, без модели и без сети. Ставим
REM до рекомендаций: новые статьи дня получают первоисточник в тот же прогон.
python "%REPO%\tools\abstract_orig.py" >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

REM Рекомендации автору («Взгляд машины знаний») — догон по полным разборам, у которых
REM раздела ещё нет. Единственный платный шаг файла. Замер 11 августа по журналу: около
REM $0.006 за статью со всеми четырьмя переводами, то есть шестьдесят статей за ночь —
REM примерно $0.36 при дневном потолке владельца 4–5 долларов. Очередь внутри инструмента
REM идёт по ценности (авторские работы, потом свежие), а не по алфавиту.
python "%REPO%\tools\recommend.py" --all-full --limit 60 >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

REM Ссылки на соседей: дописать признак полной версии там, где раздел построен раньше,
REM чем поле появилось. Бесплатно, без модели, вхолостую отрабатывает за секунды.
python "%REPO%\tools\recommend.py" --fix-links >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

REM Пересборка страниц и выкладка. БЕЗ этого шага вся работа выше остаётся в data.json:
REM теги размечены, связи починены, рекомендации написаны — а на сайте вчерашние страницы.
REM Именно так и вышло с векторной разметкой: поля писались с 9 августа, страницы их не
REM показывали. Пересборка идёт целиком, потому что затронуты и агрегаты (облако тегов,
REM страницы законов и учёных), а не только отдельные статьи.
REM B42_LEAD=1 — страж пересборки пропускает только ведущую; ночная задача и есть она.
set B42_LEAD=1
REM Отдельного `run.py publish` здесь НЕТ и быть не должно: выкладка в R2 идёт хвостом
REM самой команды (run.py, _publish_to_r2). Второй вызов залил бы то же самое ещё раз.
python run.py html >> "%LOGDIR%\upkeep_%STAMP%.log" 2>&1
if not "%ERRORLEVEL%"=="0" set RC=%ERRORLEVEL%

echo [%DATE% %TIME%] upkeep rc=%RC% >> "%LOGDIR%\upkeep-history.log"

if not "%RC%"=="0" (
  python "%REPO%\tools\status_tg.py" --run-failed upkeep %RC% "logs\upkeep_%STAMP%.log"
)
endlocal & exit /b %RC%
