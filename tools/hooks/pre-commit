#!/bin/sh
# ЕДИНСТВЕННЫЙ ИСТОЧНИК хука pre-commit. Живёт в git; в .git/hooks его ставит
# tools/install_hooks.py. Раньше хук существовал только в .git/hooks — то есть у одного
# человека на одной машине, без истории и без возможности исправить его в ветке.
#
# Хук обязан работать СЕКУНДЫ. Всё, что дольше, люди обходят через --no-verify, и тогда
# защиты нет вовсе — это хуже, чем её отсутствие, потому что на неё рассчитывают.

# ─── Замок главной папки (2026-07-30) ───────────────────────────────────────
# Коммитить из главного дерева может только ведущая сессия (B42_LEAD=1). Причина —
# два реальных столкновения за два дня: чужая сессия работала в главном дереве,
# ведущая переключила ветку, и чужой коммит лёг не туда.
MAIN_DIR="C:/Users/nadez/PycharmProjects/bridge42worlds"
CUR_DIR=$(pwd -W 2>/dev/null || pwd)
case "$CUR_DIR" in
  "$MAIN_DIR"|"$(echo "$MAIN_DIR" | tr 'A-Z' 'a-z')")
    if [ "$B42_LEAD" != "1" ]; then
      echo ""
      echo "==> СТОП: это главная папка проекта, коммитит из неё только ведущая сессия."
      echo "    Заведи свою: git worktree add ../b42-<роль> -b <ветка> origin/main"
      echo "    (см. ПРАВИЛА-РАБОТЫ.md, урок 6 — уже дважды теряли коммиты на этом)"
      echo ""
      exit 1
    fi ;;
esac

# ─── Двойная кодировка в общих файлах (2026-07-31) ──────────────────────────
# Доску команды сломали дважды за сутки дозаписью через PowerShell без -Encoding utf8.
# В редакторе выглядит терпимо, в терминале уже нет, а замечает это следующий — через день.
if command -v python >/dev/null 2>&1; then
  if ! python tools/fix_encoding.py --check >/dev/null 2>&1; then
    echo ""
    echo "==> СТОП: в общих файлах двойная кодировка (Ð¾Ð±ÑƒÑ‡ÐµÐ½Ð¸Ðµ вместо обучение)."
    python tools/fix_encoding.py --check
    echo ""
    exit 1
  fi
fi

# ─── Смок-тест изменённых файлов (2026-08-17, обещание (г) аудита) ──────────
# Почему это стоит здесь, а не в проверке после выкладки. 14 августа главная не показала
# ни одной статьи на пяти языках из-за вызова функции esc(), которой не было в файле.
# Файл был синтаксически ВЕРЕН, поэтому node --check его бы пропустил — но тот же день
# показал цену любой опечатки в js: она валит ленту целиком и молча. Секунда проверки
# на коммит против полудня пустого сайта — обмен очевидный.
#
# Проверяем ТОЛЬКО изменённые файлы: полный обход 700 питоновских файлов занимает минуты,
# и хук, который думает минуту, отключат в первый же занятой вечер.
CHANGED=$(git diff --cached --name-only --diff-filter=ACM)

JS=$(echo "$CHANGED" | grep -E '\.(js|mjs)$' || true)
if [ -n "$JS" ]; then
  if command -v node >/dev/null 2>&1; then
    for f in $JS; do
      [ -f "$f" ] || continue
      if ! node --check "$f" 2>/tmp/b42-node-err; then
        echo ""
        echo "==> СТОП: синтаксическая ошибка в $f"
        sed -n '1,6p' /tmp/b42-node-err
        echo ""
        exit 1
      fi
    done
  else
    # Не молчим: пропущенная проверка должна быть ВИДНА. Молчаливый пропуск читается
    # как «проверено», и это ровно та ошибка, которую мы ловим весь август.
    echo "(!) node не найден — синтаксис js не проверен"
  fi
fi

PY=$(echo "$CHANGED" | grep -E '\.py$' || true)
if [ -n "$PY" ]; then
  if command -v python >/dev/null 2>&1; then
    for f in $PY; do
      [ -f "$f" ] || continue
      if ! python -m py_compile "$f" 2>/tmp/b42-py-err; then
        echo ""
        echo "==> СТОП: синтаксическая ошибка в $f"
        sed -n '1,6p' /tmp/b42-py-err
        echo ""
        exit 1
      fi
    done
  else
    echo "(!) python не найден — синтаксис py не проверен"
  fi
fi

JSON=$(echo "$CHANGED" | grep -E '\.json$' || true)
if [ -n "$JSON" ] && command -v python >/dev/null 2>&1; then
  for f in $JSON; do
    [ -f "$f" ] || continue
    # Индексы и графы руками не коммитят (правило волн), но настройки, промпты и
    # правила публикации — коммитят постоянно, и битый json в них ломает прогон молча.
    if ! python -c "import json,sys; json.load(open(sys.argv[1],encoding='utf-8'))" "$f" 2>/tmp/b42-json-err; then
      echo ""
      echo "==> СТОП: $f не разбирается как JSON"
      sed -n '1,3p' /tmp/b42-json-err
      echo ""
      exit 1
    fi
  done
fi

# ─── Ключи (2026-08-17) ─────────────────────────────────────────────────────
# 5 июля .env уехал в публичную историю и пролежал там девять дней. Ключи давно мертвы,
# но чистка истории переписывает все SHA и ломает рабочие папки всей команде — то есть
# СЛЕД стоит дорого, а не пустить ключ внутрь бесплатно. Проверка смотрит только
# добавляемые строки и знает наши образцы целиком, поэтому не спотыкается об обрезанные
# упоминания ключей в отчётах.
if command -v python >/dev/null 2>&1; then
  if ! python tools/secret_scan.py; then
    echo ""
    exit 1
  fi
fi

exit 0
