# Образец .env — ТОЛЬКО имена полей, без значений. Сам .env в git не хранится и не
# попадает в резервную копию: бэкап читается теми же ключами, которые в нём лежали бы.
# Значения — у владельца. Файл создан 2026-08-05 по итогам репетиции восстановления:
# скрипт восстановления ссылался на образец, которого не существовало.
#
# Скопировать в корень репозитория как .env и заполнить.

# --- Минимум, без которого не оживёт ничего -------------------------------
DEEPSEEK_API_KEY=            # генерация статей
R2_ACCOUNT_ID=               # он же CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=            # S3-доступ к R2: заливка сайта и чтение бэкапа
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bridge42worlds-site
CLOUDFLARE_API_TOKEN=        # wrangler: Worker, D1, KV, Vectorize
CLOUDFLARE_ACCOUNT_ID=

# --- Нужно для отдельных участков ----------------------------------------
DEEPINFRA_API_KEY=           # обложки (FLUX)
KAGGLE_API_TOKEN=            # обновление дампа arXiv
CLOUDFLARE_DNS_TOKEN=        # правка DNS отдельным токеном, у него меньше прав
R2_BACKUP_BUCKET=bridge42worlds-backup

# --- Сервисы вокруг сайта -------------------------------------------------
SERVICE_KEY=                 # заголовок x-b42-service: обход норм для наших же прогонов
B42_TUTOR_ADMIN_KEY=         # выдача токенов доступа к боту-тьютору
WEBHOOK_SECRET=
TG_BOT_TOKEN=                # уведомления о выкладке и сторож пульса
TG_CHAT_ID=
COUNCIL_INVITE_CODE=         # приглашение в совет
COUNCIL_ADMIN_TOKEN=

# --- Почта (reg.ru) -------------------------------------------------------
MAIL_HOST=mail.hosting.reg.ru
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_USERS=                  # список ящиков через запятую
