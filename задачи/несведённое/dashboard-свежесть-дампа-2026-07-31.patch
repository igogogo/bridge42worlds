+
+/* «Где эта статья на карте» — ссылка со страницы статьи в /analytics с наводкой на её точку
+   (задача волны 2, 2026-07-31). Карта отвечала на вопрос «из чего состоит облако», но не на
+   «а моя статья где» — а именно его задаёт читатель, дочитавший до конца.
+
+   Живёт здесь, а не в шаблоне: mini-graph.js уже подключён на каждой странице статьи, и
+   правка видна без пересборки сайта. Ссылку ставим сразу под мини-графом связей — рядом
+   по смыслу: «вот твои связи, а вот твоё место в целом». */
+(function () {
+    var box = document.querySelector('.mini-graph--article');
+    if (!box) return;
+    var seg = location.pathname.split('/').filter(Boolean);
+    var ai = seg.indexOf('archive');
+    var id = (ai >= 0 && seg.length > ai + 2) ? seg[ai + 2] : '';
+    // id статьи arXiv: 2607.27193v1 или 2607.27193. Всё остальное — не статья, ссылку не ставим.
+    if (!/^\d{4}\.\d{4,6}(v\d+)?$/.test(id)) return;
+    var li = seg.indexOf('lang');
+    var lang = (li >= 0 && seg.length > li + 1) ? seg[li + 1] : (window.lang || 'en');
+    var TXT = ({
+        ru: 'Где эта статья на карте проекта',
+        en: 'Where this article sits on the project map',
+        es: 'Dónde está este artículo en el mapa del proyecto',
+        ar: 'أين تقع هذه المقالة على خريطة المشروع',
+        fr: 'Où se situe cet article sur la carte du projet'
+    })[lang] || 'Where this article sits on the project map';
+    var a = document.createElement('a');
+    a.className = 'mg-map-link';
+    a.href = '/lang/' + lang + '/analytics/#id=' + encodeURIComponent(id);
+    a.textContent = TXT + ' →';
+    (box.parentNode || document.body).insertBefore(a, box.nextSibling);
+})();
