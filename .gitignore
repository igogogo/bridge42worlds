# arXiv fetch-кэш метаданных — промежуточный, не нужен для сайта/регенера
*/arxiv-atom.xml
*/arxiv-oai.xml
**/arxiv-atom.xml
**/arxiv-oai.xml

# Источник контента для регенера (не грузится клиентом; держим локально)
lang/*/archive/*/*/data.json

scratch_*
bridge42worlds_files/
html-regen-*.log

# Cloudflare. Папка целиком была вне git — из-за одного файла с доступами. Побочный эффект:
# код Worker'а, который обслуживает весь сайт, не имел ни истории, ни копии (2026-07-30).
# Теперь наоборот: код в git, из него исключено поимённо то, что секретно или производно.
cloudflare/DEVOPS-HANDOFF.md
cloudflare/.dev.vars
cloudflare/.wrangler/
cloudflare/.r2-manifest.json
cloudflare/.backup-manifest.json
cloudflare/.vector-manifest.json
cloudflare/.context-manifest.json
cloudflare/publish-failures.log
cloudflare/__pycache__/
data/bulk-select/
data/arxiv-index.jsonl
# Выгрузка на эмбеддинг (embeddings_export.py): наши статьи 2,5 МБ, с arXiv будут гигабайты.
# Пересоздаётся одной командой, в git ему делать нечего.
data/embeddings-*.jsonl
_devops-handoff.zip

# Собранный сайт публикуется через cloudflare/deploy_r2.py (R2), не через git-пуш —
# см. ПРАВИЛА-РАБОТЫ.md. lang/**/*.jpg (было отдельной строкой) теперь тоже покрыто этим правилом.
lang/**

# ...кроме страницы-гида: about.json — не сборка, а ИСХОДНИК. Русский написан руками,
# остальные четыре языка переведены один раз и правятся руками же. Другого источника
# у этого текста нет: потеряй рабочее дерево — и гид не восстановить ничем, кроме как
# написать заново. 69 КБ на пять языков, git это не заметит.
#
# Цепочка из четырёх строк, а не одна «!lang/*/data/about.json»: git не заглядывает
# внутрь исключённого каталога, поэтому путь надо открывать по одному уровню —
# и на каждом уровне тут же закрывать всё остальное.
!lang/*/
lang/*/*
!lang/*/data/
lang/*/data/*
!lang/*/data/about.json

# Старые прототипы: столы-лаборатории и демо уровней. Заменены курсом, ссылок на них нет,
# но держим локально как историю. На сайт не публикуются.
_prototypes/

# ключ слепой приёмки уровней (blind_levels.py): ответ не должен попадаться на глаза
.blind-levels-key.json

# Замок сборки: живёт ровно столько, сколько идёт пересборка. В git ему делать нечего,
# а в git status он мозолит глаза каждой сессии, которая смотрит, чисто ли дерево.
.build.lock

# Входящие предложения совета: там ключи участников и их слова — личные данные живых
# людей. В git им не место, даже в приватном: репозиторий переживёт и участника,
# и его согласие. Рядом лежит входящие.пример.jsonl — формат виден, людей в нём нет.
data/council/входящие.jsonl
data/council/участники.jsonl
data/council/черновик-*.json

# Страницы заседаний строит council_build.py из data/council/*.json — это сборка,
# как lang/. Правка руками живёт до первой пересборки.
# Слэш в начале обязателен: без него шаблон совпал бы и с data/council — то есть
# закрыл бы от git сами ИСХОДНИКИ заседаний вместе со сборкой.
/council/

# Слепые выборки на проверку глазами — рабочий материал мерки, пересоздаётся зерном 42.
data/blind-*.json

# Промежуточные файлы проверки слепых зон (blindspot_probe.py --scan): выборка кандидатов
# из дампа arXiv. Первый файл — 790 МБ, `git add` на нём висит минутами. Пересоздаются
# одной командой. Результат `blindspot-result.json` наоборот КОММИТИМ: он маленький,
# и по нему потом сверяются выводы.
data/blindspot-candidates*.jsonl
data/blindspot-random.jsonl

# Карточки проверки гипотез — рабочий материал мерки, пересоздаётся.
data/analogy-hypothesis.json
